{
  "app": "npx ts-node --prefer-ts-exts aws-architecture/infrastructure/bin/udodiri-social-club.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk.context.json",
      "**/*.otter",
      "**/*.json",
      "node_modules"
